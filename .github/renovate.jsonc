{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "branchPrefix": "renovate/",
  "labels": ["dependencies"],
  // Merge automatically once a PR is green (CI + minimumReleaseAge, both
  // enforced as required status checks on main) and up-to-date with main.
  // Uses platformAutomerge (GitHub's native merge, default true) - safe
  // because main's ruleset requires the CI and renovate/stability-days
  // checks, so GitHub won't merge a red/pending PR.
  "automerge": true,
  // Avoids the default renovate@whitesourcesoftware.com author, which Mend
  // flags with "Vigilant Mode" (visibly-unsigned-commit warnings) on
  // GitHub.com since that address belongs to an account this repo doesn't
  // control. Attributing commits to the repo owner's own identity instead.
  // Display name MUST be RFC5322-quoted: an unquoted "(via renovate)" is
  // parsed as a comment and silently stripped, confirmed live - the first
  // real PR's commit author ended up as plain "zarthross" instead.
  "gitAuthor": "\"zarthross (via renovate)\" <1111592+zarthross@users.noreply.github.com>",
  // The `nix` manager (flake.lock inputs), `custom.jsonata` (pinned-actions.json),
  // and `custom.regex` (renovate-version pin, per-package sources.json tags)
  // are enabled.
  // Note: when enabledManagers is set, custom managers must be explicitly
  // added as "custom.jsonata"/"custom.regex", or they silently extract
  // nothing - same trap as the nix manager's own enabled flag below.
  "enabledManagers": ["nix", "custom.jsonata", "custom.regex"],
  // The `nix` manager ships with `enabled: false` in its own defaultConfig
  // (it's opt-in, unlike most GitHub-recommended managers) - enabledManagers
  // above only controls which managers are *allowed* to run, it does NOT
  // flip this per-manager default. Both are required.
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am"]
  },
  // 3-day cooldown before proposing any update, so a freshly (possibly
  // compromised or buggy) tagged release has time to be pulled/flagged
  // upstream before flakey picks it up.
  "minimumReleaseAge": "3 days",
  // GitHub Actions versions used in generated .github/workflows/*.yaml are
  // NOT edited directly - they're rendered by `nix run .#render-workflows`
  // from modules/repository/ci.nix's `actionUses` helper, which reads
  // modules/repository/ci/pinned-actions.json (the actual source of truth).
  // Kept as plain JSON, not Nix, so Renovate's JSONata custom manager can
  // update it directly without needing to parse/edit Nix syntax.
  "customManagers": [
    {
      "customType": "jsonata",
      "description": "Update pinned GitHub Actions recorded in modules/repository/ci/pinned-actions.json",
      "fileFormat": "json",
      "managerFilePatterns": ["/^modules/repository/ci/pinned-actions\\.json$/"],
      "matchStrings": [
        "$each($, function($v, $k) { { \"depName\": $k, \"currentValue\": $v.version, \"currentDigest\": $v.sha } })"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Keep the pinned renovate-version (renovatebot/github-action input, in modules/repository/ci.nix) up to date. Deliberately pinned rather than left on the action's default floating '44' tag, so a broken release can't silently start being used. This still benefits from minimumReleaseAge above, so a newly published release must survive 3 days untouched before it's proposed here.",
      "managerFilePatterns": ["/^modules/repository/ci\\.nix$/"],
      "matchStrings": [
        "renovate-version = \"(?<currentValue>[\\d.]+)\";"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/renovatebot/renovate",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "jsonata",
      "description": "Bump each package's tag in modules/*/sources.json. owner/repo/tag are read directly from each file, so adding a new package needs no change here. bitwarden/clients ships web/cli/desktop/browser releases in one tag stream, so it alone gets an extractVersion filtering to desktop- tags while keeping the literal tag string (update-hash.sh fetches by this exact tag).",
      "fileFormat": "json",
      "managerFilePatterns": ["/^modules/[^/]+/sources\\.json$/"],
      "matchStrings": [
        "$merge([{ \"depName\": owner & \"/\" & repo, \"currentValue\": tag, \"datasource\": \"github-releases\" }, owner = \"bitwarden\" ? { \"extractVersion\": \"^(?<version>desktop-v.*)$\" } : {}])"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to commit SHA, keeping the version tag as the readable value",
      "matchDatasources": ["github-tags"],
      "pinDigests": true
    },
    {
      "description": "Regenerate .github/workflows/*.yaml after pinned-actions.json or ci.nix's renovate-version pin changes, so the Nix-rendered workflows stay in sync in the same commit",
      "matchFileNames": [
        "modules/repository/ci/pinned-actions.json",
        "modules/repository/ci.nix"
      ],
      "postUpgradeTasks": {
        "commands": ["bash modules/repository/ci/renovate-render-workflows.sh"],
        "executionMode": "branch",
        "fileFilters": [".github/workflows/*.yaml"]
      }
    },
    {
      "description": "Refresh url/hash/version for the one package whose sources.json tag changed, by running its own update-hash.sh. workingDirTemplate scopes the command to that package's directory, so a sibling package's script never runs. Run via `nix develop ../.. -c` (devshell provides jq/curl/gh) rather than a nix-shell shebang, which doesn't work inside Renovate's container (no NIX_PATH reaches it there). The container's nix binary has no nix.conf enabling flakes/nix-command (that's client-side config, not inherited via the bind-mounted daemon), so the flags must be passed explicitly here - confirmed live.",
      "matchFileNames": ["modules/*/sources.json"],
      "postUpgradeTasks": {
        "commands": [
          "nix --extra-experimental-features nix-command --extra-experimental-features flakes develop ../.. -c ./update-hash.sh"
        ],
        "executionMode": "branch",
        "workingDirTemplate": "{{{packageFileDir}}}"
      }
    }
  ]
}
