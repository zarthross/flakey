{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "branchPrefix": "renovate/",
  "labels": ["dependencies"],
  // The `nix` manager (flake.lock inputs), `custom.jsonata` (pinned-actions.json),
  // and `custom.regex` (renovate-version pin below) are enabled. A custom
  // regex manager for per-package sources.json versions will extend this
  // list separately.
  // Note: when enabledManagers is set, custom managers must be explicitly
  // added as "custom.jsonata"/"custom.regex", or they silently extract
  // nothing - same trap as the nix manager's own enabled flag below.
  "enabledManagers": ["nix", "custom.jsonata", "custom.regex"],
  // The `nix` manager ships with `enabled: false` in its own defaultConfig
  // (it's opt-in, unlike most GitHub-recommended managers) - enabledManagers
  // above only controls which managers are *allowed* to run, it does NOT
  // flip this per-manager default. Both are required.
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am"]
  },
  // 3-day cooldown before proposing any update, so a freshly (possibly
  // compromised or buggy) tagged release has time to be pulled/flagged
  // upstream before flakey picks it up.
  "minimumReleaseAge": "3 days",
  // GitHub Actions versions used in generated .github/workflows/*.yaml are
  // NOT edited directly - they're rendered by `nix run .#render-workflows`
  // from modules/repository/ci.nix's `actionUses` helper, which reads
  // modules/repository/ci/pinned-actions.json (the actual source of truth).
  // Kept as plain JSON, not Nix, so Renovate's JSONata custom manager can
  // update it directly without needing to parse/edit Nix syntax.
  "customManagers": [
    {
      "customType": "jsonata",
      "description": "Update pinned GitHub Actions recorded in modules/repository/ci/pinned-actions.json",
      "fileFormat": "json",
      "managerFilePatterns": ["/^modules/repository/ci/pinned-actions\\.json$/"],
      "matchStrings": [
        "$each($, function($v, $k) { { \"depName\": $k, \"currentValue\": $v.version, \"currentDigest\": $v.sha } })"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Keep the pinned renovate-version (renovatebot/github-action input, in modules/repository/ci.nix) up to date. Deliberately pinned rather than left on the action's default floating '44' tag, so a broken release can't silently start being used. This still benefits from minimumReleaseAge above, so a newly published release must survive 3 days untouched before it's proposed here.",
      "managerFilePatterns": ["/^modules/repository/ci\\.nix$/"],
      "matchStrings": [
        "renovate-version = \"(?<currentValue>[\\d.]+)\";"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/renovatebot/renovate",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to commit SHA, keeping the version tag as the readable value",
      "matchDatasources": ["github-tags"],
      "pinDigests": true
    },
    {
      "description": "Regenerate .github/workflows/*.yaml after pinned-actions.json or ci.nix's renovate-version pin changes, so the Nix-rendered workflows stay in sync in the same commit",
      "matchFileNames": [
        "modules/repository/ci/pinned-actions.json",
        "modules/repository/ci.nix"
      ],
      "postUpgradeTasks": {
        "commands": ["bash modules/repository/ci/renovate-render-workflows.sh"],
        "executionMode": "branch",
        "fileFilters": [".github/workflows/*.yaml"],
        "installTools": {
          "nix": {}
        }
      }
    }
  ]
}
